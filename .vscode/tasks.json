{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "gear"
      },
      "detail": "Run CMake configure (generates build/)",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "configure.ps1"],
      "problemMatcher": []
    },

    {
      "label": "CMake Build (Debug)",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "tools"
      },
      "detail": "Run CMake build for debugging",
      // Delega pro build.ps1, que carrega o ambiente do MSVC (Launch-VsDevShell)
      // antes do cmake — a lógica de build mora num lugar só.
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "build.ps1", "Debug"],
      // $msCompile pro cl.exe (C da SDL); o matcher inline cobre o clang++
      // (diagnóstico estilo GCC: arquivo:linha:coluna: error: msg). O ninja roda
      // com cwd em build/, então caminhos relativos resolvem a partir de lá.
      "problemMatcher": [
        "$msCompile",
        {
          "owner": "clang",
          "fileLocation": ["autoDetect", "${workspaceFolder}/build"],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": "build"
    },

    {
      "label": "CMake Build (Release)",
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "tools"
      },
      "detail": "Run CMake build for release",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "build.ps1", "Release"],
      "problemMatcher": [
        "$msCompile",
        {
          "owner": "clang",
          "fileLocation": ["autoDetect", "${workspaceFolder}/build"],
          "pattern": {
            "regexp": "^(.+?):(\\d+):(\\d+):\\s+(warning|error|fatal error):\\s+(.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "group": "build"
    },

    {
      "label": "Build Slang Shaders",
      "detail": "Compile all Slang shaders",
      "icon": {
        "color": "terminal.ansiMagenta",
        "id": "paintcan"
      },
      "type": "shell",
      "group": "build",
      "command": "./slangc.sh",
      "problemMatcher": {
        "owner": "slangc",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "(.+\\.(frag|vert)):(\\d+): (error|warning): (.+)",
          "file": 1,
          "line": 3,
          "severity": 4,
          "message": 5,
        }
      }
    },

    {
      "label": "Build All (Debug)",
      "detail": "Build everything for debuggin",
      "icon": {
        "id": "rocket",
        "color": "terminal.ansiGreen",
      },
      "dependsOn": [
        "Build Slang Shaders",
        "CMake Build (Debug)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },

    {
      "label": "Build All (Release)",
      "detail": "Build everything for release",
      "icon": {
        "id": "rocket",
        "color": "terminal.ansiBlue",
      },
      "dependsOn": [
        "Build Slang Shaders",
        "CMake Build (Release)"
      ],
      "dependsOrder": "parallel",
      "group": "build",
    },

    // For my custom build keybinding
    {
      "label": "build",
      "dependsOn": "Build All (Debug)",
      "detail": "For my custom keyboard shortcut",
      "icon": {
        "id": "keyboard"
      }
    }
  ],
}
