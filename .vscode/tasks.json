{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "File",
      "description": "Path to a file",
      "type": "promptString",
    },
    {
      "id": "Link type",
      "description": "Type of link to create",
      "type": "pickString",
      "default": "lib",
      "options": [
        {
          "label": "Binaries",
          "value": "lib"
        },
        {
          "label": "Headers",
          "value": "include"
        }
      ]
    },
  ],
  "tasks": [
    {
      "label": "CMake Build (Debug)",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "tools"
      },
      "detail": "Run CMake build for debugging",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },

    {
      "label": "CMake Build (Release)",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "tools"
      },
      "detail": "Run CMake build for release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--config",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },

    {
      "label": "Build Slang Shaders",
      "detail": "Compile all slang shaders",
      "icon": {
        "color": "terminal.ansiMagenta",
        "id": "paintcan"
      },
      "type": "shell",
      "group": "build",
      "command": "./slangc.sh",
      "problemMatcher": {
        "owner": "slangc",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "(.+\\.(frag|vert)):(\\d+): (error|warning): (.+)",
          "file": 1,
          "line": 3,
          "severity": 4,
          "message": 5,
        }
      }
    },

    {
      "label": "Build All (Release)",
      "detail": "Build all (C++ and GLSL) for release",
      "icon": {
        "id": "rocket",
        "color": "terminal.ansiGreen",
      },
      "dependsOn": [
        "Build Slang Shaders",
        "Build CMake (Debug)"
      ],
      "dependsOrder": "parallel",
      "group": "build",
    },

    {
      "label": "project: build (Debug)",
      "detail": "Build all (C++ and GLSL) for debugging",
      "icon": {
        "id": "rocket",
        "color": "terminal.ansiRed",
      },
      "dependsOn": [
        "slangc: compile",
        "g++: build (Debug)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },

    // For my custom build keybinding
    {
      "label": "build",
      "dependsOn": "Build All (Debug)",
    }
  ],
}
